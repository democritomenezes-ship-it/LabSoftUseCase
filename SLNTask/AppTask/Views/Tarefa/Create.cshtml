@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Tarefa</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form action="/Tarefa/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Descricao" class="control-label">Descrição</label>
                <input type="text" name="Descricao" id="Descricao"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="DataPlanejada" class="control-label">Data Planejada</label>
                <input type="datetime-local" name="DataPlanejada" id="DataPlanejada"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="DataIniciada" class="control-label">Data Iniciada</label>
                <input type="datetime-local" name="DataIniciada" id="DataIniciada"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="DataFinalizada" class="control-label">Data Finalizada</label>
                <input type="datetime-local" name="DataFinalizada" id="DataFinalizada"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="DataCancelada" class="control-label">Data Cancelada</label>
                <input type="datetime-local" name="DataCancelada" id="DataCancelada"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="StatusTarefa" class="control-label">Status da Tarefa</label>
                <input type="text" name="StatusTarefa" id="StatusTarefa"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="Prazo" class="control-label">Prazo</label>
                <input type="number" name="Prazo" id="Prazo"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="FuncionarioId" class="control-label">Funcionário</label>
                <select name="FuncionarioId" id="FuncionarioId"
                        class="form-control">
                    <option value="">Selecione um funcionário</option>
                    @foreach (var funcionario in ViewBag.ListaFuncionario)
                    {
                        <option value="@funcionario.Value">
                            @funcionario.Text
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/Tarefa/Index">Back to List</a>
</div>
