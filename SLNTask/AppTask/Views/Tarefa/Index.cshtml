@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.DataPlanejada)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.DataIniciada)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.DataFinalizada)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.DataCancelada)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.StatusTarefa)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.Prazo)
            </th>
            <th class="table-dark">
                @Html.DisplayNameFor(model => model.Funcionario)
            </th>
            <th class="table-dark">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Descricao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataPlanejada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataIniciada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataFinalizada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataCancelada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StatusTarefa)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Prazo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Funcionario.Nome)
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-warning btn-sm text-white">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-info btn-sm text-white">Details</a>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@item.Codigo"
                                data-descricao="@item.Descricao">
                            Delete
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir a tarefa <strong id="modalItemDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post">
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                
                const button = event.relatedTarget;

                
                const itemId = button.getAttribute('data-id');
                const itemDescricao = button.getAttribute('data-descricao');

                
                const modalDescricao = deleteModal.querySelector('#modalItemDescricao');
                if (modalDescricao) {
                    modalDescricao.textContent = itemDescricao;
                }

               
                const deleteForm = deleteModal.querySelector('#deleteForm');
                if (deleteForm) {
                    deleteForm.action = `/Tarefa/Delete/${itemId}`;
                }
            });
        }
    </script>
}