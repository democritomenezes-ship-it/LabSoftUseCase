@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Incidente</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/Incidente/Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="DescricaoProblema" class="control-label">Descrição do Problema</label>
                <input type="text" name="DescricaoProblema" id="DescricaoProblema" class="form-control" />
            </div>
            <div class="form-group">
                <label for="DataIncidente" class="control-label">Data Incidente</label>
                <input type="datetime-local" name="DataIncidente" id="DataIncidente" class="form-control" />
            </div>
            <div class="form-group">
                <label for="Solucao" class="control-label">Solução</label>
                <input type="text" name="Solucao" id="Solucao" class="form-control" />
            </div>
            <div class="form-group">
                <label for="Resolvido" class="control-label">Resolvido</label>
                <input type="checkbox" name="Resolvido" id="Resolvido" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}